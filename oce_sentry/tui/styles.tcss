Screen {
    layout: vertical;
}

#body {
    height: 1fr;
}

#incidents {
    width: 3fr;
    height: 100%;
}

#side {
    width: 2fr;
    height: 100%;
    border-left: solid $panel;
}

#detail {
    height: auto;
    min-height: 14;
    padding: 1 2;
}

#log {
    height: 1fr;
    border-top: solid $panel;
    padding: 0 2;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

ConfirmRun {
    align: center middle;
}

#confirm-box {
    width: 90;
    height: auto;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#confirm-detail {
    height: auto;
}

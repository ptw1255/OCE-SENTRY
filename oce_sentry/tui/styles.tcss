Screen {
    layout: vertical;
}

#body {
    height: 1fr;
}

/* The title column is what an OCE reads first, so the table gets the room.
   The detail pane is a fixed width rather than a fraction: at 2fr it took 40%
   of the terminal and squeezed titles down to about eight characters. */
#incidents {
    width: 1fr;
    height: 100%;
}

#side {
    width: 42;
    min-width: 36;
    height: 100%;
    border-left: solid $panel;
}

/* Below roughly 100 columns the pane costs more than it gives: the incident
   column collapses to two characters and the queue stops being readable. */
Screen.-narrow #side {
    display: none;
}

#detail {
    height: auto;
    min-height: 14;
    padding: 1 2;
}

/* Make the cursor row unmistakable: the detail pane follows it, and on a dense
   table it is otherwise easy to lose which incident you are reading. */
DataTable > .datatable--cursor {
    background: $accent;
    color: $text;
    text-style: bold;
}

DataTable {
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

#log {
    height: 1fr;
    border-top: solid $panel;
    padding: 0 2;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

ConfirmRun {
    align: center middle;
}

#confirm-box {
    width: 90;
    height: auto;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#confirm-detail {
    height: auto;
}

#sli-body {
    height: 1fr;
}

#sli-table {
    height: auto;
    max-height: 40%;
}

#sli-detail {
    height: 1fr;
    border-top: solid $panel;
}

#sli-summary {
    width: 1fr;
    padding: 1 2;
}

#sli-breakdown {
    width: 1fr;
    border-left: solid $panel;
}

#sli-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#bug-body {
    height: 1fr;
}

#bug-table {
    height: 1fr;
}

#bug-detail {
    height: auto;
    min-height: 12;
    padding: 1 2;
    border-top: solid $panel;
}

#bug-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

CreateBugScreen {
    align: center middle;
}

/* The form scrolls and the buttons are pinned. Previously the buttons were
   laid out below the content, which put them off-screen on a 26-row terminal:
   the one screen where a human types something had an invisible submit. */
#bug-form {
    width: 96;
    max-width: 96%;
    height: 90%;
    padding: 1 2;
    border: thick $accent;
    background: $surface;
    layout: vertical;
}

#bug-scroll {
    height: 1fr;
    overflow-y: auto;
}

#bug-note {
    height: 7;
    margin: 1 0;
}

#bug-preview {
    height: auto;
    padding: 1 0;
}

#bug-form-buttons {
    height: 3;
    dock: bottom;
    margin-top: 1;
}

#bug-form-buttons Button {
    margin-right: 2;
}

#bug-form-status {
    height: auto;
    max-height: 2;
}


#kit-body {
    height: 1fr;
}

#kit-table {
    height: auto;
    max-height: 45%;
}

#kit-detail {
    height: 1fr;
    border-top: solid $panel;
}

#kit-summary {
    width: 44;
    padding: 1 2;
}

#kit-content {
    width: 1fr;
    padding: 1 2;
    border-left: solid $panel;
    overflow-y: auto;
}

#kit-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}





#lib-body {
    height: 1fr;
}

#lib-table {
    height: auto;
    max-height: 50%;
}

#lib-detail {
    height: 1fr;
    border-top: solid $panel;
}

#lib-summary {
    width: 52;
    padding: 1 2;
    overflow-y: auto;
}

#lib-output {
    width: 1fr;
    padding: 0 2;
    border-left: solid $panel;
}

#lib-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}


/* Skill browser: the filter box only exists while filtering, so it takes no
   vertical space from the table until it is shown. */
#lib-filter {
    height: 3;
    margin: 0 1;
}

/* Kits view. Same shape as the skill browser on purpose: the two screens are
   siblings and moving between them should not move anything on screen. */
#kit-body {
    height: 1fr;
}

#kit-table {
    height: auto;
    max-height: 45%;
}

#kit-detail {
    height: 1fr;
    border-top: solid $panel;
}

#kit-summary {
    width: 62;
    padding: 1 2;
    overflow-y: auto;
}

#kit-output {
    width: 1fr;
    padding: 0 2;
    border-left: solid $panel;
}

#kit-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

/* Settings. The summary sits above the table because "connectors are not
   wired into skill runs" is the answer most visits are looking for, and it
   should not require selecting a row. */
#set-body {
    height: 1fr;
}

#set-summary {
    height: auto;
    padding: 1 2;
    background: $panel;
}

#set-table {
    height: auto;
    max-height: 45%;
}

/* One full-width detail pane. The old right-hand log was empty most of the
   time and cost half the width of the only part carrying real detail --
   access requirements do not fit in sixty columns. */
#set-detail {
    height: 1fr;
    border-top: solid $panel;
}

#set-info {
    width: 1fr;
    padding: 1 2;
}

#set-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}


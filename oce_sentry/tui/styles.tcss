Screen {
    layout: vertical;
}

#body {
    height: 1fr;
}

/* The title column is what an OCE reads first, so the table gets the room.
   The detail pane is a fixed width rather than a fraction: at 2fr it took 40%
   of the terminal and squeezed titles down to about eight characters. */
#incidents {
    width: 1fr;
    height: 100%;
}

#side {
    width: 52;
    min-width: 40;
    height: 100%;
    border-left: solid $panel;
}

#detail {
    height: auto;
    min-height: 14;
    padding: 1 2;
}

#log {
    height: 1fr;
    border-top: solid $panel;
    padding: 0 2;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

ConfirmRun {
    align: center middle;
}

#confirm-box {
    width: 90;
    height: auto;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#confirm-detail {
    height: auto;
}

#sli-body {
    height: 1fr;
}

#sli-table {
    height: auto;
    max-height: 40%;
}

#sli-detail {
    height: 1fr;
    border-top: solid $panel;
}

#sli-summary {
    width: 1fr;
    padding: 1 2;
}

#sli-breakdown {
    width: 1fr;
    border-left: solid $panel;
}

#sli-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#bug-body {
    height: 1fr;
}

#bug-table {
    height: 1fr;
}

#bug-detail {
    height: auto;
    min-height: 12;
    padding: 1 2;
    border-top: solid $panel;
}

#bug-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

CreateBugScreen {
    align: center middle;
}

#bug-form {
    width: 100;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: thick $accent;
    background: $surface;
}

#bug-note {
    height: 8;
    margin: 1 0;
}

#bug-preview {
    height: auto;
    max-height: 30;
    padding: 1 0;
}

#bug-form-buttons {
    height: auto;
    margin-top: 1;
}

#bug-form-buttons Button {
    margin-right: 2;
}


#kit-body {
    height: 1fr;
}

#kit-table {
    height: auto;
    max-height: 45%;
}

#kit-detail {
    height: 1fr;
    border-top: solid $panel;
}

#kit-summary {
    width: 44;
    padding: 1 2;
}

#kit-content {
    width: 1fr;
    padding: 1 2;
    border-left: solid $panel;
    overflow-y: auto;
}

#kit-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

